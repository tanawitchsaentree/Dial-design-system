    },
    "linger": {
      "$value": "240ms"
    },
    "exit": {
      "$value": "120ms"
    },
    "fill": {
      "$value": "120ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P3"
        ],
        "why": "Enter decelerates into place; exit accelerates away, because nobody watches what leaves."
      }
    },
    "enter": {
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ]
    },
    "exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    },
    "inout": {
      "$value": [
        0.45,
        0,
        0.2,
        1
      ]
    }
