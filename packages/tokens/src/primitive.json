    }
  },
  "gloss": {
    "$type": "number",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P3"
        ],
        "why": "Gloss 0.2 for matte ABS sets how strong the lit hairline on each part is."
      }
    },
    "abs": {
      "$value": 0.2
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6"
        ],
        "why": "Breakpoints where units reflow from one column to many, never inside a unit."
      }
    },
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    },
    "xl": {
      "$value": "1280px"
    },
    "2xl": {
      "$value": "1536px"
    }
  },
  "container": {
    "$type": "dimension",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6"
        ],
        "why": "Page widths that hold whole units side by side without stretching a unit's face."
      }
    },
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    },
    "xl": {
      "$value": "1200px"
    },
    "2xl": {
      "$value": "1440px"
    }
  },
  "columns": {
    "$type": "number",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6"
        ],
        "why": "Units are placed on four columns on a phone, eight on a tablet and twelve on a desktop."
      }
    },
    "4": {
      "$value": 4
    },
    "8": {
      "$value": 8
    },
    "12": {
      "$value": 12
    }
  },
  "z": {
    "$type": "number",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6"
        ],
        "why": "Layers stay few. A unit sits on the page, and only sheets and messages rise above it."
      }
    },
    "base": {
      "$value": 0
    },
    "raised": {
      "$value": 10
    },
    "sticky": {
      "$value": 100
    },
    "overlay": {
      "$value": 1000
    },
    "toast": {
      "$value": 1100
    }
  },
  "alpha": {
    "$type": "number",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P6"
        ],
        "why": "Disabled parts flatten and fade to half, keeping their outline readable against the body."
      }
    },
    "half": {
      "$value": 0.5
    }
  },
  "frost": {
    "$type": "number",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P9"
        ],
        "why": "The frosted glass recipe for the small parts that move is a light blur, a lift in saturation and a small brightness step, so what is behind a cap reads through it softly and the top-left light stays on its surface."
      }
    },
    "blur": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "a frost, not a pane: the groove and ticks still read through a cap"
    },
    "saturate": {
      "$value": 1.4
    },
    "brightness": {
      "$value": 1.05,
      "$description": "light edition"
    },
    "brightness-dark": {
      "$value": 0.92,
      "$description": "dark edition: glass darkens a step so text on it keeps 4.5:1"
    },
    "fill-opacity": {
      "$value": 0.62,
      "$description": "the value's light in the groove behind a cap"
    },
    "solid": {
      "$value": 1,
      "$description": "fallback: no transparency"
    }
  }
}