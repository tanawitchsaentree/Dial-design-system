  "duration": {
    "$type": "duration",
    "$extensions": {
      "kiln.why": {
        "p": [
          "P3",
          "P6"
        ],
        "why": "Fast in, slow out. A press lands at once, the spring brings it back, and nothing moves while idle."
      }
    },
    "none": {
      "$value": "0ms"
    },
    "press": {
      "$value": "65ms"
    },
    "segment": {
      "$value": "80ms"
