{
  "focus-ring": {
    "color": {
      "$type": "color",
      "$value": "{focus.ring}"
    },
    "halo": {
      "$type": "color",
      "$value": "{focus.halo}"
    },
    "width": {
      "$type": "dimension",
      "$value": "{width.ring}"
    },
    "halo-width": {
      "$type": "dimension",
      "$value": "{width.halo}"
    }
  },
  "grid": {
    "columns": {
      "$type": "number",
      "$value": "{layout.columns}"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "{layout.gutter}"
    },
    "margin": {
      "$type": "dimension",
      "$value": "{layout.margin}"
    }
  },
  "container": {
    "margin": {
      "$type": "dimension",
      "$value": "{layout.margin}"
    },
    "max-sm": {
      "$type": "dimension",
      "$value": "{layout.container-sm}"
    },
    "max-md": {
      "$type": "dimension",
      "$value": "{layout.container-md}"
    },
    "max-lg": {
      "$type": "dimension",
      "$value": "{layout.container-lg}"
    },
    "max-xl": {
      "$type": "dimension",
      "$value": "{layout.container-xl}"
    },
    "max-2xl": {
      "$type": "dimension",
      "$value": "{layout.container-2xl}"
    }
  },
  "stack": {
    "gap-xs": {
      "$type": "dimension",
      "$value": "{gap.xs}"
    },
    "gap-sm": {
      "$type": "dimension",
      "$value": "{gap.md}"
    },
    "gap-md": {
      "$type": "dimension",
      "$value": "{gap.2xl}"
    },
    "gap-lg": {
      "$type": "dimension",
      "$value": "{gap.3xl}"
    },
    "gap-xl": {
      "$type": "dimension",
      "$value": "{gap.section}"
    }
  },
  "$extensions": {
    "kiln.why": {
      "p": [
        "P3",
        "P6"
      ],
      "why": "Component tokens for layout primitives and focus, pointing only at semantic roles named by the principles."
    }
  },
  "unit": {
    "$extensions": {
      "kiln.why": {
        "p": [
          "P1",
          "P2",
          "P6"
        ],
        "why": "The device card read from anchor A. It sets the body, the panel radius ratio, the inset ratio, the knob share and the one orange."
      }
    },
    "bg": {
      "$value": "{surface.solid}",
      "$type": "color"
    },
    "shadow": {
      "$value": "{elevation.unit}",
      "$type": "shadow"
    },
    "radius-ratio": {
      "$value": "{corner.unit-ratio}",
      "$type": "number"
    },
    "inset-ratio": {
      "$value": "{corner.inset-ratio}",
      "$type": "number"
    },
    "knob-ratio": {
      "$value": "{corner.knob-ratio}",
      "$type": "number"
    },
    "knob-bg": {
      "$value": "{action.accent}",
      "$type": "color"
    },
    "knob-shade": {
      "$value": "{action.accent-shade}",
      "$type": "color"
    },
    "window-shadow": {
      "$value": "{elevation.well}",
      "$type": "shadow"
    }
  }
}